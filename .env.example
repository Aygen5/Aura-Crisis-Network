# Aura Crisis Network - Environment Variables Template
# Copy this file to .env for local development (Do NOT commit .env to Git)

# Database Connection String
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=aura_db;Username=aura_user;Password=YOUR_LOCAL_DEV_PASSWORD;

# JWT Settings (SecretKey must be a secure random key at least 32 characters / 256 bits long)
JwtSettings__SecretKey=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG
JwtSettings__Issuer=AuraCrisisNetwork
JwtSettings__Audience=AuraClients
JwtSettings__ExpiryMinutes=15
